# undo after restore roundtrip with real target recovery and drift protection
# Exercises real target undo without fabricating a .bak git repository,
# verifies fresh home reports nothing to undo, tests drift protection,
# and verifies the legacy backup-repository revert when .bak is a git repo.

# --- Fresh home case ---
# On a fresh home without any restore, undo reports nothing to undo.
! exec bak undo
stderr 'nothing to undo'

# --- Real target undo flow (no git repo in .bak) ---
# Run real backup with quick preset.
exec bak backup --preset quick
stdout 'Backup created:'

# Capture the backup ID.
exec sh -c 'ls .bak/backups/ | head -1 > $WORK/bak_id.txt'

# Modify target AGENTS.md before restore (this will be the pre-restore state).
exec sh -c 'printf "pre-restore-agents\n" > $HOME/.config/opencode/AGENTS.md'

# Restore with --force to apply backed-up state and create recovery point.
exec sh -c 'ID=$(cat $WORK/bak_id.txt) && bak restore --force $ID'
stdout 'Restore complete'

# Target was restored to backed-up content (# Agents).
exec grep 'Agents' $HOME/.config/opencode/AGENTS.md

# --- Drift test case ---
# Mutate target to introduce drift after restore.
exec sh -c 'printf "drifted-agents\n" > $HOME/.config/opencode/AGENTS.md'

# Undo must fail closed on drift and touch zero files.
! exec bak undo
stderr 'drift'

# Verify target was not modified by the rejected undo attempt.
exec grep 'drifted-agents' $HOME/.config/opencode/AGENTS.md

# --- Clean undo case ---
# Align target back to post-restore state (# Agents).
exec sh -c 'printf "# Agents\n" > $HOME/.config/opencode/AGENTS.md'

# Run bak undo — should project pre-state back to targets.
exec bak undo
stdout 'Reverted to previous state'
stdout 'reverted: ~/.config/opencode/AGENTS.md'

# Verify the real target file was restored to its pre-restore state.
exec grep 'pre-restore-agents' $HOME/.config/opencode/AGENTS.md

# --- Legacy backup-repository revert path ---
# When .bak happens to be a git repository, bak undo also reverts it.
exec git init .bak
exec git -C .bak config user.email test@bak-cli.local
exec git -C .bak config user.name bak-test
cp test-v1.txt .bak/test.txt
exec git -C .bak add test.txt
exec git -C .bak commit -m bak:initial
cp test-v2.txt .bak/test.txt
exec git -C .bak add test.txt
exec git -C .bak commit -m bak:modified

# Make another pre-restore change and restore again to create a fresh applied recovery point.
exec sh -c 'printf "pre-restore-agents-v2\n" > $HOME/.config/opencode/AGENTS.md'
exec sh -c 'ID=$(cat $WORK/bak_id.txt) && bak restore --force $ID'
stdout 'Restore complete'

# Run undo with legacy git repo present — should revert target and git repo.
exec bak undo
stdout 'Reverted to previous state'
exec grep 'pre-restore-agents-v2' $HOME/.config/opencode/AGENTS.md

# Verify the legacy bak git repository commit was also reverted.
exec git -C .bak log -1 --format=%s
stdout 'bak: undo'

# Fixture files for git commits.
-- test-v1.txt --
v1
-- test-v2.txt --
v2
